{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbridge.africa/schemas/oscal-1.2.1/assessment-results.schema.json",
  "title": "NIST OSCAL 1.2.1 Assessment Results (AgentBridge subset)",
  "type": "object",
  "required": ["assessment-results"],
  "additionalProperties": false,
  "properties": {
    "assessment-results": {
      "type": "object",
      "required": ["uuid", "metadata", "results"],
      "properties": {
        "uuid": { "type": "string", "minLength": 8 },
        "metadata": { "$ref": "#/$defs/metadata" },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["uuid", "title", "description", "start", "findings"],
            "properties": {
              "uuid": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "start": { "type": "string" },
              "findings": {
                "type": "array",
                "items": { "$ref": "#/$defs/finding" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["title", "last-modified", "version", "oscal-version"],
      "properties": {
        "title": { "type": "string" },
        "last-modified": { "type": "string" },
        "version": { "type": "string" },
        "oscal-version": { "type": "string", "const": "1.2.1" },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["uuid", "title", "description", "target"],
      "properties": {
        "uuid": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "target": {
          "type": "object",
          "required": ["type", "target-id", "status"],
          "properties": {
            "type": { "type": "string" },
            "target-id": { "type": "string" },
            "status": {
              "type": "object",
              "required": ["state"],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": ["satisfied", "not-satisfied"]
                }
              }
            }
          }
        }
      }
    }
  }
}
