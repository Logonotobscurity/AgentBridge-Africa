{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbridge.africa/schemas/oscal-1.2.1/poam.schema.json",
  "title": "NIST OSCAL 1.2.1 Plan of Action and Milestones (AgentBridge subset)",
  "type": "object",
  "required": ["plan-of-action-and-milestones"],
  "additionalProperties": false,
  "properties": {
    "plan-of-action-and-milestones": {
      "type": "object",
      "required": ["uuid", "metadata", "poam-items"],
      "properties": {
        "uuid": { "type": "string", "minLength": 8 },
        "metadata": {
          "type": "object",
          "required": ["title", "last-modified", "version", "oscal-version"],
          "properties": {
            "title": { "type": "string" },
            "last-modified": { "type": "string" },
            "version": { "type": "string" },
            "oscal-version": { "type": "string", "const": "1.2.1" }
          }
        },
        "poam-items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["uuid", "title", "description"],
            "properties": {
              "uuid": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "props": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "value"],
                  "properties": {
                    "name": { "type": "string" },
                    "value": { "type": "string" }
                  }
                }
              },
              "related-findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["finding-uuid"],
                  "properties": {
                    "finding-uuid": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
